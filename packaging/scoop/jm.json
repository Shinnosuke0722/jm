    "version": "VERSION_PLACEHOLDER",
    "description": "Cross-platform JDK and Java version manager",
    "homepage": "https://github.com/Shinnosuke0722/jm",
    "license": "MIT|Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Shinnosuke0722/jm/releases/download/vVERSION_PLACEHOLDER/jm-windows-x86_64.zip",
            "hash": "SHA256_WINDOWS_PLACEHOLDER"
